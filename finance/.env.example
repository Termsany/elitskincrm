# ===== إعدادات برنامج المتابعة المالية =====
# انسخ هذا الملف إلى .env على السيرفر واملأ القيم. لا ترفع .env على GitHub.

# كلمة مرور الدخول للبرنامج — لازم تغيّرها (البرنامج يرفض الدخول لو سبتها change-me)
APP_PASSWORD=change-me-strong-password

# سر توقيع الجلسات. لو سبته فاضي البرنامج يولّد واحد عشوائي ويحفظه تلقائيًا.
SESSION_SECRET=

# العملة المعروضة
CURRENCY=ج.م

# ===== ربط دفترة والذكاء الاصطناعي =====
# الأسهل: سيبهم فاضيين وأضف المفاتيح من داخل البرنامج (صفحة الإعدادات).
DAFTRA_SUBDOMAIN=
DAFTRA_APIKEY=
DAFTRA_DOMAIN=daftara.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
